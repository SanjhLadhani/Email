EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
OLLAMA_URL=https://your-tunnel.trycloudflare.com/api/generate
OLLAMA_MODEL=qwen3:4b
# Long random string shared with the Colab notebook
NTFY_TOPIC=triage-change-me

# Hosted model API, so nothing has to be started by hand
# (free key: console.groq.com/keys or aistudio.google.com/apikey).
# Your email text is sent to this provider whenever it is used.
FALLBACK_PROVIDER=groq
FALLBACK_API_KEY=
# FALLBACK_MODEL=model-a,model-b   (optional; comma-separated: the next is used when one hits its quota)
# MODEL_ORDER: colab,api = Colab first, API when Colab is off.  api = never use Colab.
MODEL_ORDER=colab,api
